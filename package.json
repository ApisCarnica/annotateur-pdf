{
  "name": "annotateur-pdf",
  "productName": "Annotateur PDF",
  "version": "1.0.0",
  "description": "Annotation de PDF au stylet",
  "author": "Houël & Klépal",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.houel-klepal.annotateur-pdf",
    "productName": "Annotateur PDF",
    "files": ["main.js", "preload.js", "app/**/*", "build/icon.png"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Annotateur PDF",
      "artifactName": "Annotateur-PDF-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      { "ext": "pdf", "name": "Document PDF", "role": "Editor" }
    ],
    "publish": [
      { "provider": "github", "owner": "ApisCarnica", "repo": "annotateur-pdf", "releaseType": "release" }
    ]
  }
}
